# Copy to .env and adjust. Never commit .env.
# Precedence: real environment variables > .env > pausa.config.json > defaults.

PORT=4747
BIND=127.0.0.1
# Relative paths are resolved from the repo root.
DATA_DIR=data
UPLOAD_MAX_MB=10

# Set automatically by `pnpm demo` (Phase 6). Only set by hand for a fixed URL.
# PUBLIC_URL=https://example.trycloudflare.com

# Required by `pnpm demo`: who may pass the tunnel's email gate (Cloudflare sends them a PIN).
# Comma-separated addresses, or a whole domain. Confirm your company's email domain first.
#   ALLOWED_MAIL=ana@empresa.pt,rui@empresa.pt
#   ALLOWED_MAIL=*@empresa.pt
ALLOWED_MAIL=

# Fixed address instead of the quick tunnel (DECISIONS D-50, OPERATIONS §8). When both are set, `pnpm demo`
# runs this named tunnel and the email gate is your Cloudflare Access app (ALLOWED_MAIL is then not used).
# TUNNEL_NAME=pausa
# TUNNEL_URL=https://pausa.yourdomain.com
