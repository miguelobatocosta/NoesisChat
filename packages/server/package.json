{
  "name": "@pausa/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "build": "node build.mjs",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "init": "tsx src/cli/init.ts",
    "test:coverage": "vitest run --coverage",
    "invite": "tsx src/cli/invite.ts"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.9",
    "@fastify/static": "10.1.12",
    "@pausa/shared": "workspace:*",
    "better-sqlite3": "13.2.0",
    "fastify": "5.12.8",
    "socket.io": "4.8.4",
    "ulid": "3.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "5.1.1",
    "esbuild": "0.28.2",
    "socket.io-client": "4.8.4",
    "tsx": "4.23.15"
  }
}
